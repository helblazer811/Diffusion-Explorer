/**
 * Direct triangle rendering shader for filled contours.
 *
 * Renders filled contour triangles generated by marching squares.
 * Each triangle instance reads its vertices from a storage buffer
 * and renders with the appropriate color based on contour level.
 *
 * This shader has two passes:
 * 1. vs_fill/fs_fill: Render triangles with per-level color and alpha blending
 * 2. vs_blit/fs_blit: Copy cached texture to canvas
 */

struct RenderUniforms {
  width: f32,
  height: f32,
  dpr: f32,
  numLevels: f32,
  currentLevel: f32,
  xMin: f32,
  xMax: f32,
  yMin: f32,
  yMax: f32,
  opacity: f32,
  colorR: f32,
  colorG: f32,
  colorB: f32,
  colorA: f32,
  _pad0: f32,
  _pad1: f32,
}

struct VertexOutput {
  @builtin(position) position: vec4<f32>,
  @location(0) color: vec4<f32>,
}

@group(0) @binding(0) var<uniform> uniforms: RenderUniforms;
@group(0) @binding(1) var<storage, read> triangles: array<f32>;

/**
 * Convert normalized coordinates [0,1] to clip space [-1,1].
 * Y is flipped for correct canvas orientation.
 */
fn toClipSpace(pos: vec2<f32>) -> vec4<f32> {
  let x = pos.x * 2.0 - 1.0;
  let y = 1.0 - pos.y * 2.0;  // Flip Y
  return vec4<f32>(x, y, 0.0, 1.0);
}

// ============================================================================
// Fill Pass: Render triangles with color
// ============================================================================

/**
 * Vertex shader for fill pass.
 * Reads triangle vertices from storage buffer.
 *
 * Triangle buffer layout per triangle (8 floats):
 * [x0, y0, x1, y1, x2, y2, levelIdx, valid]
 *
 * Each triangle instance has 3 vertices (vertex_index 0, 1, 2).
 */
@vertex
fn vs_fill(
  @builtin(vertex_index) vertexIndex: u32,
  @builtin(instance_index) instanceIndex: u32
) -> VertexOutput {
  var output: VertexOutput;

  // Read triangle data
  let baseIdx = instanceIndex * 8u;
  let valid = triangles[baseIdx + 7u];

  // If invalid, place vertex off-screen
  if (valid < 0.5) {
    output.position = vec4<f32>(-10.0, -10.0, 0.0, 1.0);
    output.color = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    return output;
  }

  // Check if this triangle belongs to the current level
  let triangleLevel = triangles[baseIdx + 6u];
  if (abs(triangleLevel - uniforms.currentLevel) > 0.5) {
    output.position = vec4<f32>(-10.0, -10.0, 0.0, 1.0);
    output.color = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    return output;
  }

  // Get vertex position based on vertex index
  var pos: vec2<f32>;
  switch (vertexIndex % 3u) {
    case 0u: {
      pos = vec2<f32>(triangles[baseIdx + 0u], triangles[baseIdx + 1u]);
    }
    case 1u: {
      pos = vec2<f32>(triangles[baseIdx + 2u], triangles[baseIdx + 3u]);
    }
    case 2u: {
      pos = vec2<f32>(triangles[baseIdx + 4u], triangles[baseIdx + 5u]);
    }
    default: {
      pos = vec2<f32>(0.0, 0.0);
    }
  }

  output.position = toClipSpace(pos);

  // Pass color from uniforms
  output.color = vec4<f32>(
    uniforms.colorR,
    uniforms.colorG,
    uniforms.colorB,
    uniforms.colorA * uniforms.opacity
  );

  return output;
}

/**
 * Fragment shader for fill pass.
 * Outputs the interpolated color.
 */
@fragment
fn fs_fill(input: VertexOutput) -> @location(0) vec4<f32> {
  return input.color;
}

// ============================================================================
// Blit Pass: Copy cached texture to canvas
// ============================================================================

struct BlitVertexOutput {
  @builtin(position) position: vec4<f32>,
  @location(0) uv: vec2<f32>,
}

@vertex
fn vs_blit(@builtin(vertex_index) vertexIndex: u32) -> BlitVertexOutput {
  var output: BlitVertexOutput;

  // Full-screen triangle
  var pos: vec2<f32>;
  var uv: vec2<f32>;
  switch (vertexIndex) {
    case 0u: {
      pos = vec2<f32>(-1.0, -1.0);
      uv = vec2<f32>(0.0, 1.0);
    }
    case 1u: {
      pos = vec2<f32>(3.0, -1.0);
      uv = vec2<f32>(2.0, 1.0);
    }
    case 2u: {
      pos = vec2<f32>(-1.0, 3.0);
      uv = vec2<f32>(0.0, -1.0);
    }
    default: {
      pos = vec2<f32>(0.0, 0.0);
      uv = vec2<f32>(0.0, 0.0);
    }
  }

  output.position = vec4<f32>(pos, 0.0, 1.0);
  output.uv = uv;
  return output;
}

@group(0) @binding(0) var blitTexture: texture_2d<f32>;
@group(0) @binding(1) var blitSampler: sampler;

@fragment
fn fs_blit(input: BlitVertexOutput) -> @location(0) vec4<f32> {
  return textureSample(blitTexture, blitSampler, input.uv);
}
