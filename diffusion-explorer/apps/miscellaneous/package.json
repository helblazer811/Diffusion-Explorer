{
	"name": "miscellaneous",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"bundle-workers": "node scripts/bundle-workers.js",
		"build": "npm run bundle-workers && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"train:pull-toward-mean": "tsx scripts/pull_toward_mean/train.ts",
		"sample:pull-toward-mean": "tsx scripts/pull_toward_mean/sample.ts",
		"train:flow-dlic": "tsx scripts/flow_model_dlic/train.ts",
		"compute:flow-dlic-grids": "tsx scripts/flow_model_dlic/compute_velocity_grid.ts",
		"sample:flow-dlic": "tsx scripts/flow_model_dlic/sample_trajectories.ts",
		"prepare:flow-dlic": "npm run train:flow-dlic && npm run compute:flow-dlic-grids && npm run sample:flow-dlic",
		"train:eulerian-vs-lagrangian": "tsx scripts/eulerian_vs_lagrangian/train.ts",
		"compute:eulerian-vs-lagrangian-grids": "tsx scripts/eulerian_vs_lagrangian/compute_velocity_grid.ts",
		"sample:eulerian-vs-lagrangian": "tsx scripts/eulerian_vs_lagrangian/sample_trajectories.ts",
		"prepare:eulerian-vs-lagrangian": "npm run train:eulerian-vs-lagrangian && npm run compute:eulerian-vs-lagrangian-grids && npm run sample:eulerian-vs-lagrangian",
		"train:ot-coupling": "tsx scripts/optimal_transport_coupling/train.ts",
		"sample:ot-coupling": "tsx scripts/optimal_transport_coupling/sample.ts",
		"prepare:ot-coupling": "npm run train:ot-coupling && npm run sample:ot-coupling"
	},
	"devDependencies": {
		"@diffusion-explorer/diffusion": "*",
		"@diffusion-explorer/ui": "*",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^20.10.0",
		"esbuild": "^0.20.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tsx": "^4.7.0",
		"typescript": "^5.9.3",
		"@types/three": "^0.170.0",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@tensorflow/tfjs": "^4.22.0",
		"@tensorflow/tfjs-backend-wasm": "^4.22.0",
		"@tensorflow/tfjs-core": "^4.22.0",
		"@tensorflow/tfjs-node": "^4.22.0",
		"d3": "^7.9.0",
		"reveal.js": "^5.2.1",
		"three": "^0.170.0"
	}
}
