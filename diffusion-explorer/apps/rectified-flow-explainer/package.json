{
	"name": "rectified-flow-explainer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"bundle-workers": "node scripts/bundle-workers.js",
		"build": "npm run bundle-workers && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && node scripts/deploy.js",
		"train-models": "tsx scripts/train-models.ts",
		"train:flow-matching": "tsx scripts/train-flow-matching.ts",
		"train:rectified-flow": "tsx scripts/train-rectified-flow.ts",
		"cache-samples": "tsx scripts/cache-samples.ts"
	},
	"devDependencies": {
		"@diffusion-explorer/diffusion": "*",
		"@diffusion-explorer/ui": "*",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^20.10.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tsx": "^4.7.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@tensorflow/tfjs": "^4.22.0",
		"@tensorflow/tfjs-backend-wasm": "^4.22.0",
		"@tensorflow/tfjs-core": "^4.22.0",
		"@tensorflow/tfjs-node": "^4.22.0",
		"d3": "^7.9.0",
		"fs-extra": "^11.2.0",
		"mathjax-full": "^3.2.1"
	}
}
