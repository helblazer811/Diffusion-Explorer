{
	"name": "diffusion-explorer-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"bundle-workers": "node scripts/bundle-workers.js",
		"build": "npm run bundle-workers && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"postinstall": "cp -r node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm static/tfjs-backend-wasm/",
		"predeploy": "npm run build",
		"deploy": "touch build/.nojekyll; gh-pages -d build",
		"train": "tsx scripts/train.ts",
		"train:all": "tsx scripts/train-all.ts",
		"sample": "tsx scripts/sample.ts",
		"sample:all": "tsx scripts/sample-all.ts",
		"cache-all": "npm run train:all && npm run sample:all"
	},
	"devDependencies": {
		"@diffusion-explorer/diffusion": "*",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^20.10.0",
		"esbuild": "^0.20.0",
		"gh-pages": "^6.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tsx": "^4.7.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.6"
	},
	"dependencies": {
		"@tensorflow/tfjs": "^4.22.0",
		"@tensorflow/tfjs-backend-wasm": "^4.22.0",
		"@tensorflow/tfjs-core": "^4.22.0",
		"@tensorflow/tfjs-node": "^4.22.0",
		"aws-sdk": "^2.1692.0",
		"d3": "^7.9.0",
		"katex": "^0.16.22",
		"mock-aws-s3": "^4.0.2",
		"multivariate-normal": "^0.1.2",
		"nock": "^14.0.4",
		"numeric": "^1.2.6",
		"path.join": "^1.0.0"
	}
}
